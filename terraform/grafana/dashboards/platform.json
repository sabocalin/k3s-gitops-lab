    {
      "type": "timeseries",
      "title": "Unavailable replicas",
      "description": "Desired minus available, per Deployment. Above 0 for long means pods that can't start: look at the logs below or kubectl describe.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "kube_deployment_spec_replicas{cluster=\"k3s-gitops-lab\", namespace=~\"$namespace\"} - kube_deployment_status_replicas_available{cluster=\"k3s-gitops-lab\", namespace=~\"$namespace\"}",
          "range": true,
          "legendFormat": "{{namespace}}/{{deployment}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
