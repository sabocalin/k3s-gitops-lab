    {
      "type": "logs",
      "title": "Logs",
      "description": "Every pod in the selected namespaces. Use the search box at the top to filter (a regular expression, case-insensitive).",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "{cluster=\"k3s-gitops-lab\", namespace=~\"$namespace\"} |~ \"(?i)$search\"",
          "range": true,
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
