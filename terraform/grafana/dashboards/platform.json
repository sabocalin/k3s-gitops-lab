      "title": "Log lines by namespace",
      "description": "Lines per minute per namespace, from Loki.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum by (namespace) (count_over_time({cluster=\"k3s-gitops-lab\", namespace=~\"$namespace\"} [1m]))",
