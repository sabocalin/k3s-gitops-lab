    {
      "type": "timeseries",
      "title": "Error-like lines by namespace",
      "description": "Lines per minute containing error, fail, panic or fatal (case-insensitive). Noisy by nature: a trend matters more than the number.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum by (namespace) (count_over_time({cluster=\"k3s-gitops-lab\", namespace=~\"$namespace\"} |~ \"(?i)(error|fail|panic|fatal)\" [1m]))",
          "range": true,
          "legendFormat": "{{namespace}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
