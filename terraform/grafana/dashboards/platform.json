    {
      "type": "timeseries",
      "title": "Scrape targets up",
      "description": "Targets Alloy scraped successfully, per job: one per lab-api pod, and kube-state-metrics. A gap is the node being stopped; a drop while it runs is a monitoring problem (#48).",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (job) (up{cluster=\"k3s-gitops-lab\"})",
          "range": true,
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
