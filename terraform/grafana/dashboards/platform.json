      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Container restarts (per hour)",
      "description": "Restarts in the preceding hour, per pod.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total{cluster=\"k3s-gitops-lab\", namespace=~\"$namespace\"}[1h]))",
          "range": true,
          "legendFormat": "{{namespace}}/{{pod}}"
        }
