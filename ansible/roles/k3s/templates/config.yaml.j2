# Managed by Ansible (k3s-gitops-lab). K3s reads this at start.
node-name: {{ k3s_node_name }}
# Names the API server certificate must be valid for, so kubectl can connect over the
# tailnet (#15) instead of the public IP (port 6443 is closed to the internet).
tls-san:
{% for san in k3s_tls_sans %}
  - {{ san }}
{% endfor %}
# Admin kubeconfig readable by root only.
write-kubeconfig-mode: "0600"
# Encrypt Kubernetes Secrets at rest in the datastore (off by default).
secrets-encryption: true
# #90: pod/service ranges away from the VPC's 10.42.0.0/16 (see defaults/main.yml).
cluster-cidr: {{ k3s_cluster_cidr }}
service-cidr: {{ k3s_service_cidr }}
cluster-dns: {{ k3s_cluster_dns }}
# DNS for pods and CoreDNS's upstream (kubelet --resolv-conf): not the node's resolv.conf,
# which carries the tailnet search domain and the VPC resolver's VPC address.
resolv-conf: /etc/rancher/k3s/resolv.conf
# #39: also accept GitHub Actions OIDC tokens (see that file); K3s passes this to the
# embedded API server.
kube-apiserver-arg:
  - authentication-config=/etc/rancher/k3s/authentication-config.yaml
