# Managed by Ansible (k3s-gitops-lab). Same shape as the unit K3s's install script writes.
[Unit]
Description=Lightweight Kubernetes (k3s {{ k3s_version }})
Documentation=https://k3s.io
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=notify
EnvironmentFile=-/etc/default/k3s
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/local/bin/k3s server

[Install]
WantedBy=multi-user.target
